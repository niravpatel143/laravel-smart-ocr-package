{
    "name": "laravelsmartocr/laravel-smart-ocr",
    "description": "Multi-provider OCR for Laravel — Tesseract, Google Vision, AWS Textract, Azure, Mistral, Claude, OpenAI, PDF. Schema extraction, Markdown/RAG output, smart routing, human review, PII redaction.",
    "keywords": [
        "laravel", "ocr", "tesseract", "google-vision", "aws-textract", "azure",
        "mistral", "schema-extraction", "document-parsing", "rag", "pii-redaction", "php"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Laravel Smart OCR Team",
            "email": "support@laravelsmartocr.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "smalot/pdfparser": "^2.0"
    },
    "suggest": {
        "google/cloud-vision": "For Google Cloud Vision OCR driver",
        "google/auth": "For Google service account authentication",
        "aws/aws-sdk-php": "For AWS Textract OCR driver"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelSmartOCR\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelSmartOCR\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelSmartOCR\\SmartOCRServiceProvider"
            ],
            "aliases": {
                "SmartOCR": "LaravelSmartOCR\\Facades\\SmartOCR"
            }
        }
    }
}
