{
    "name": "laravelsmartocr/laravel-smart-ocr",
    "description": "Laravel Smart OCR & Document Data Extractor - A powerful OCR and document parsing engine for Laravel",
    "keywords": ["laravel", "ocr", "document", "parser", "tesseract", "pdf", "invoice", "receipt"],
    "license": "MIT",
    "authors": [
        {
            "name": "Laravel Smart OCR Team",
            "email": "support@laravelsmartocr.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "thiagoalessio/tesseract_ocr": "^2.12",
        "smalot/pdfparser": "^2.0",
        "intervention/image": "^2.7 || ^3.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "orchestra/testbench": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelSmartOCR\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelSmartOCR\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelSmartOCR\\SmartOCRServiceProvider"
            ],
            "aliases": {
                "SmartOCR": "LaravelSmartOCR\\Facades\\SmartOCR"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}