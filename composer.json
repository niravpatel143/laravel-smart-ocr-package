{
    "name": "laravelsmartocr/laravel-smart-ocr",
    "description": "Laravel OCR package — extract text from images and PDFs using Tesseract, Google Cloud Vision, AWS Textract, Azure AI Vision, Claude Vision, and OpenAI GPT-4o behind a single normalized API.",
    "keywords": [
        "laravel", "ocr", "optical-character-recognition",
        "image-to-text", "pdf-text-extraction",
        "tesseract", "google-vision", "aws-textract", "azure-vision",
        "claude-vision", "openai-vision",
        "invoice-parser", "document-extraction"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Laravel Smart OCR Team",
            "email": "support@laravelsmartocr.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "smalot/pdfparser": "^2.0"
    },
    "suggest": {
        "google/cloud-vision": "For Google Cloud Vision OCR driver",
        "google/auth": "For Google service account authentication",
        "aws/aws-sdk-php": "For AWS Textract OCR driver"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelSmartOCR\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelSmartOCR\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelSmartOCR\\SmartOCRServiceProvider"
            ],
            "aliases": {
                "SmartOCR": "LaravelSmartOCR\\Facades\\SmartOCR"
            }
        }
    }
}
